# ─────────────────────────────────────────────────────────────
# Hotel System — environment variables
# MOCK_MODE=true runs EVERYTHING with zero keys (on-device data, simulators).
# ─────────────────────────────────────────────────────────────
MOCK_MODE=true
NEXT_PUBLIC_MOCK_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (live mode) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose
DATABASE_URL=                      # postgres://… (Drizzle migrations)

# AI — Msaidizi works offline without these (rule-based Swahili parser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                    # Whisper voice-note transcription

# Safaricom Daraja (sandbox: https://developer.safaricom.co.ke)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=

# Africa's Talking SMS (sandbox username = "sandbox")
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=hotel-system-verify
WHATSAPP_APP_SECRET=               # verifies X-Hub-Signature-256

# Cron protection for /api/cron/daily
CRON_SECRET=
